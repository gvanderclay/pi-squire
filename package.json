{
	"name": "pi-squire",
	"version": "0.32.0",
	"description": "Run background Pi delegates in tmux, Herdr, Rex or Paseo, get results back, and isolate checkouts with optional managed worktrees",
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"delegation",
		"subagents",
		"tmux",
		"worktrees",
		"herdr",
		"rex",
		"paseo"
	],
	"license": "MIT",
	"author": "Gage Vander Clay <gvanderclay@gmail.com>",
	"homepage": "https://github.com/gvanderclay/pi-squire#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gvanderclay/pi-squire.git"
	},
	"bugs": {
		"url": "https://github.com/gvanderclay/pi-squire/issues"
	},
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"packageManager": "pnpm@10.33.0",
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"files": [
		"src",
		"docs/*.md",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"scripts": {
		"lint": "biome ci .",
		"typecheck": "tsc -p .",
		"test": "node --test test/*.test.ts",
		"check": "pnpm lint && pnpm typecheck && pnpm test",
		"release": "node scripts/release.mjs"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": ">=1.5.0",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.7",
		"@earendil-works/pi-ai": "1.5.2",
		"@earendil-works/pi-coding-agent": "1.5.2",
		"@earendil-works/pi-tui": "1.5.2",
		"@types/node": "26.6.6",
		"pi-session-mail": "0.7.1",
		"typebox": "1.4.7",
		"typescript": "7.0.2"
	},
	"dependencies": {
		"@getpaseo/client": "0.15.4"
	}
}
