{
	"name": "pi-squire",
	"version": "0.1.0",
	"description": "Starts a delegate Pi session in a background tmux window, sends it the task over message:*, and shows the parent its result",
	"keywords": [
		"pi-package"
	],
	"type": "module",
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"files": [
		"index.ts",
		"agents.ts",
		"tmux.ts",
		"results.ts",
		"README.md"
	],
	"scripts": {
		"test": "node --test test/*.test.ts"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	}
}
