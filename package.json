{
	"name": "pi-squire",
	"version": "0.1.0",
	"description": "Starts a delegate Pi session in a background tmux window, sends it the task over message:*, and shows the parent its result",
	"keywords": [
		"pi-package"
	],
	"license": "MIT",
	"author": "Gage Vander Clay <gvanderclay@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gvanderclay/pi-squire.git"
	},
	"type": "module",
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"files": [
		"index.ts",
		"child.ts",
		"agents.ts",
		"tmux.ts",
		"results.ts",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"test": "node --test test/*.test.ts"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.0.0",
		"typebox": "1.3.27"
	}
}
