{
	"name": "pi-squire",
	"version": "0.1.0",
	"description": "Starts a delegate Pi session in a background tmux window, sends it the task over message:*, and shows the parent its result",
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension"
	],
	"license": "MIT",
	"author": "Gage Vander Clay <gvanderclay@gmail.com>",
	"homepage": "https://github.com/gvanderclay/pi-squire#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gvanderclay/pi-squire.git"
	},
	"bugs": {
		"url": "https://github.com/gvanderclay/pi-squire/issues"
	},
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"packageManager": "pnpm@10.33.0",
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"files": [
		"index.ts",
		"child.ts",
		"agents.ts",
		"tmux.ts",
		"results.ts",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"scripts": {
		"lint": "biome ci .",
		"typecheck": "tsc -p .",
		"test": "node --test test/*.test.ts",
		"check": "pnpm lint && pnpm typecheck && pnpm test"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@earendil-works/pi-coding-agent": "1.0.0",
		"@types/node": "26.6.3",
		"typebox": "1.3.27",
		"typescript": "7.0.2"
	}
}
